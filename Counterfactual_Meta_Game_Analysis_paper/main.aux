\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces CURB-conditional leave-one-out on the bargaining average game (MENE). Each cell is the range $[\qopname  \relax m{min}_C \Delta , \qopname  \relax m{max}_C \Delta ]$ of an agent's LOO welfare effect over the CURB sets containing it (sign convention $\Delta W = W(X) - W(X\setminus \{s_i\})$). PPO improves welfare in every context; PSRO's sign depends on context; MAPPO and 5.2-low never improve welfare. Agents not shown have negligible effect across all CURB sets.\relax }}{6}{table.caption.16}\protected@file@percent }
\newlabel{tab:curb-bargaining}{{1}{6}{CURB-conditional leave-one-out on the bargaining average game (MENE). Each cell is the range $[\min _C \Delta , \max _C \Delta ]$ of an agent's LOO welfare effect over the CURB sets containing it (sign convention $\Delta W = W(X) - W(X\setminus \{s_i\})$). PPO improves welfare in every context; PSRO's sign depends on context; MAPPO and 5.2-low never improve welfare. Agents not shown have negligible effect across all CURB sets.\relax }{table.caption.16}{}}
